# Copy to .env and fill in. Never commit .env.
# docker compose reads .env from this folder; for a local run use
#   node --env-file=.env server/index.js

# Required when NODE_ENV=production. The server refuses to start without them.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# NODE_ENV=production
# PORT=3000
# DATA_DIR=./data
# REDIS_URL=redis://localhost:6379
# GEMINI_API_KEY=

# Discord (S18). The fight-night channel's webhook URL: a secret, so it lives
# here and never in the database. Posting also needs the switch on the admin
# page. SITE_URL is the origin the posts link to (default https://overloadfight.club).
# DISCORD_WEBHOOK_URL=
# SITE_URL=https://overloadfight.club

# SSH password for the scripts in scripts/ that log in to the NAS. They exit if it is unset.
# NAS_SSH_PASSWORD=
