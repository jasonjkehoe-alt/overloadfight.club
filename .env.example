# Copy to .env and fill in. Never commit .env.
# docker compose reads .env from this folder; for a local run use
#   node --env-file=.env server/index.js

# Required when NODE_ENV=production. The server refuses to start without them.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# NODE_ENV=production
# PORT=3000
# DATA_DIR=./data
# REDIS_URL=redis://localhost:6379
# GEMINI_API_KEY=

# SSH password for the scripts in scripts/ that log in to the NAS with paramiko.
# Leave unset to be prompted. docker_build_synology.py still takes it as an argument.
# NAS_SSH_PASSWORD=
